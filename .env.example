# ---------------------------------------------------------------------------
# PATRIX Story Platform — environment variables
# Copy this file to .env.local and fill in real values. NEVER commit .env.local.
# ---------------------------------------------------------------------------

# Supabase project (create at https://supabase.com — founder action, see
# docs/NEEDS_FROM_ME.md). The service role key must only ever be used in
# server-side code (API routes, server actions) — never expose it to the
# browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_LOCALE=en

# Feature flags (see src/lib/flags.ts for the full list and defaults)
FEATURE_PHOTO_PERSONALIZATION=off
FEATURE_REAL_IMAGE_PROVIDER=off
FEATURE_BILLING=off

# Real image provider — Google Gemini ("nano banana" image generation).
# OFF by default (FEATURE_REAL_IMAGE_PROVIDER=off uses the free mock
# provider instead). Get a key at https://aistudio.google.com ("Get API
# key"). Do not set FEATURE_REAL_IMAGE_PROVIDER=on in production until
# legal review, consent scope, and the spend caps below are all confirmed.
GEMINI_API_KEY=
GEMINI_COST_PER_IMAGE_USD=0.02

# Spend caps are enforced in the database, not here (see
# tenant_spend_caps / global_spend_cap tables and docs/DECISIONS.md "Hard
# AI spend caps are enforced in the database") — set
# global_spend_cap.monthly_cap_usd and kill_switch=false once you're ready
# to allow real spend, via the Supabase SQL editor or the owner dashboard.

# Image output safety/moderation check (fails CLOSED — every real image is
# blocked until this is set to "vendor" AND the vendor call is implemented
# in src/lib/providers/image/safety.ts). Leave unset until then.
IMAGE_SAFETY_PROVIDER=

# Stripe (test mode only — see docs/NEEDS_FROM_ME.md before ever using live keys)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_MODE=test

# Consent links
CONSENT_LINK_BASE_URL=http://localhost:3000/consent

# Rate limiting (not yet implemented — see docs/HANDOFF.md "Known
# limitations". Reserved for an Upstash Redis or similar provider.)
RATE_LIMIT_REDIS_URL=
RATE_LIMIT_REDIS_TOKEN=

# Cron worker auth (see src/app/api/cron/worker/route.ts) — set this to a
# random secret and configure your scheduler to send it as
# "Authorization: Bearer <value>". Leave blank only for local dev.
CRON_SECRET=
