# ---------------------------------------------------------------------------
# PATRIX Story Platform — environment variables
# Copy this file to .env.local and fill in real values. NEVER commit .env.local.
# ---------------------------------------------------------------------------

# Supabase project (create at https://supabase.com — founder action, see
# docs/NEEDS_FROM_ME.md). The service role key must only ever be used in
# server-side code (API routes, server actions) — never expose it to the
# browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_LOCALE=en

# Feature flags (see src/lib/flags.ts for the full list and defaults)
FEATURE_PHOTO_PERSONALIZATION=off
FEATURE_REAL_IMAGE_PROVIDER=off
FEATURE_BILLING=off

# Real image provider (Phase 3 — OFF by default). Do not set in production
# until legal review, consent scope, and spend caps below are all confirmed.
IMAGE_PROVIDER=mock
IMAGE_PROVIDER_API_KEY=
IMAGE_PROVIDER_TENANT_SPEND_CAP_USD=0
IMAGE_PROVIDER_GLOBAL_SPEND_CAP_USD=0

# Stripe (test mode only — see docs/NEEDS_FROM_ME.md before ever using live keys)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_MODE=test

# Consent links
CONSENT_LINK_BASE_URL=http://localhost:3000/consent

# Rate limiting (optional — Upstash Redis or similar; leave blank to use
# the in-memory fallback limiter used in local dev, see src/lib/rate-limit.ts)
RATE_LIMIT_REDIS_URL=
RATE_LIMIT_REDIS_TOKEN=
